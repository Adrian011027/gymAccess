# Plantilla de variables. Copiar a `.env` y rellenar; `.env` está en .gitignore.
#
# Con DJANGO_DEBUG=0 el arranque FALLA si falta DJANGO_SECRET_KEY o
# DJANGO_CORS_ORIGINS. Es deliberado: antes el servidor arrancaba igual y firmaba
# los tokens con la llave de desarrollo, que está publicada en este repositorio y en
# el historial de git, y aceptaba peticiones de cualquier origen. Un arranque que
# falla se nota; uno que se degrada en silencio, no.

# --- Django -------------------------------------------------------------------
# Generar una NUEVA, nunca reutilizar la del repo:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

DJANGO_DEBUG=0

# Dominios reales, separados por coma. Nunca '*' en producción (Host header poisoning).
DJANGO_ALLOWED_HOSTS=gym.tudominio.com

# Orígenes del frontend, con esquema. Alimenta CORS y CSRF_TRUSTED_ORIGINS.
DJANGO_CORS_ORIGINS=https://gym.tudominio.com

# 1 si hay nginx/Cloudflare delante terminando el TLS. Si el backend se expone
# directo (no debería), ponerlo en 0 o Django entra en bucle de redirección.
DJANGO_SSL_REDIRECT=1

# 1 solo si hay un proxy de confianza que reescriba X-Forwarded-For. En 0, la IP de
# la evidencia de consentimiento sale de REMOTE_ADDR, que el cliente no puede
# falsificar. Ver legal/views.py:ip_de.
DJANGO_TRAS_PROXY=1

# Ruta del panel de Django. Los bots escanean /admin/ sin parar y ese formulario NO
# pasa por el throttling de DRF. Vacío lo desactiva por completo, que es lo
# recomendable si nadie lo usa.
DJANGO_ADMIN_URL=

# Dominio con el que se arman los enlaces del código QR que se le mandan al socio por
# WhatsApp. Vacío = se usa el host de la petición, que es lo correcto detrás de un
# nginx que reenvía bien la cabecera Host.
#
# Se rellena cuando recepción entra por una dirección que el teléfono del socio NO
# alcanza: `localhost` en desarrollo, o la IP privada de la red del gimnasio. El
# enlace lo genera la petición de recepción pero lo abre el socio desde fuera, así que
# sin esto recibe un enlace que apunta a su propio teléfono. Ver accesos/enlaces.py.
#
# Debe ser el dominio público completo y con esquema, SIN barra final:
QR_BASE_URL=

# Minutos de vida del access token (por defecto 60).
JWT_ACCESS_MIN=60

# Puerto del host donde escucha el backend, solo en 127.0.0.1.
# NO usar 8000: lo ocupa `saas_agenda_backend` (el SaaS de spas) tanto en el droplet
# compartido como en esta máquina de desarrollo. Elegirlo mal tumba al vecino que ya
# está en producción, y el error ("port is already allocated") aparece al desplegar.
BACKEND_PORT=8001

# --- Postgres -----------------------------------------------------------------
# POSTGRES_HOST y POSTGRES_PORT los inyecta docker-compose (db:5432); solo hacen
# falta aquí si el backend corre fuera de Docker.
POSTGRES_DB=gymaccess
POSTGRES_USER=gymaccess
# Contraseña larga y aleatoria; este usuario NO debe ser el superusuario de Postgres:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
